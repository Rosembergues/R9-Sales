# Conexão com o Supabase (opcional).
# Sem estas variáveis o R9 Hub usa o projeto Supabase oficial (src/lib/supabase.ts).
# Para apontar para outro projeto (ex.: um banco de testes), copie este arquivo
# para .env.local e preencha com os dados de Project Settings → API.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon"
