# Copie este arquivo para ".env" (sem o .example) e preencha com os valores reais.
# O ".env" nunca deve ser compartilhado nem versionado -- só fica nesta máquina
# (o "npm run empacotar" já deixa ele fora do app.zip).

# Pasta onde os PDFs baixados do email do Power BI devem ser salvos todo dia.
# Vazio = Downloads\RelatoriosBI do usuário.
RELATORIOS_BI_PASTA=

# Supabase -> Project Settings -> Data API
# (a rede local bloqueia as portas de banco 5432/6543, por isso usamos a
# API REST em HTTPS/443 em vez de conexão direta com o Postgres)
SUPABASE_URL=https://wqdrybpjfvuzrnozomxa.supabase.co

# Chave "anon" (pública, a mesma de src/lib/supabase.ts).
SUPABASE_ANON_KEY=

# Token da importação: gere com "python scripts/gerar_token_importacao.py"
# depois de rodar supabase/automacao-token-importacao.sql. Secreto.
SUPABASE_INGEST_TOKEN=

# LEGADO -- só enquanto o token não estiver configurado. Dá acesso TOTAL ao
# banco; apague esta linha do seu .env assim que o token funcionar.
# SUPABASE_SERVICE_ROLE_KEY=
